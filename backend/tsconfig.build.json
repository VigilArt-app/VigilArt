{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // multer only augments the global Express namespace; without it here,
    // Express.Multer.File does not resolve in the public-scan upload route.
    "types": ["node", "multer"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
